<Window x:Class="MDVieW.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MDVieW" Icon="Assets/AppIcon.ico" Width="1380" Height="900" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#F5F6F8"
        FontFamily="Yu Gothic UI, Segoe UI" FontSize="13" Foreground="{StaticResource Ink}"
        AllowDrop="True" PreviewDragOver="Window_DragOver" Drop="Window_Drop" Closing="Window_Closing">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="24,15,24,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Width="40" Height="40" Source="Assets/AppIcon.png" Margin="0,0,12,0" AutomationProperties.Name="MDVieW ロゴ" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="MDVieW" FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="書く、整える。思いのままに。" Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,1,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="＋ 新規" Click="New_Click" ToolTip="新規 (Ctrl+N)" />
                    <Button Content="開く" Click="Open_Click" ToolTip="開く (Ctrl+O)" BorderBrush="{StaticResource Line}" Background="White" Margin="8,0,8,0" />
                    <Button Content="保存" Click="Save_Click" ToolTip="保存 (Ctrl+S)" Background="#EEEEFF" Foreground="#4848BC" FontWeight="SemiBold" Padding="22,8" />
                </StackPanel>
            </Grid>
        </Border>
        <Menu DockPanel.Dock="Top" Background="White" BorderThickness="0" Padding="16,0">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="新規(_N)" InputGestureText="Ctrl+N" Click="New_Click" />
                <MenuItem Header="開く(_O)…" InputGestureText="Ctrl+O" Click="Open_Click" />
                <Separator />
                <MenuItem Header="保存(_S)" InputGestureText="Ctrl+S" Click="Save_Click" />
                <MenuItem Header="名前を付けて保存(_A)…" InputGestureText="Ctrl+Shift+S" Click="SaveAs_Click" />
                <MenuItem Header="すべて保存" InputGestureText="Ctrl+Alt+S" Click="SaveAll_Click" />
                <Separator />
                <MenuItem Header="終了(_X)" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="編集(_E)">
                <MenuItem Header="元に戻す(_U)" Command="ApplicationCommands.Undo" InputGestureText="Ctrl+Z" />
                <MenuItem Header="やり直し(_R)" Command="ApplicationCommands.Redo" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="切り取り(_T)" Command="ApplicationCommands.Cut" />
                <MenuItem Header="コピー(_C)" Command="ApplicationCommands.Copy" />
                <MenuItem Header="貼り付け(_P)" Command="ApplicationCommands.Paste" />
                <MenuItem Header="すべて選択(_A)" Command="ApplicationCommands.SelectAll" />
                <Separator />
                <MenuItem Header="検索(_F)…" InputGestureText="Ctrl+F" Click="Find_Click" />
            </MenuItem>
            <MenuItem Header="表示(_V)">
                <MenuItem Header="左右に並べる" Tag="Split" Click="ViewMode_Click" />
                <MenuItem Header="テキストのみ" Tag="Source" Click="ViewMode_Click" />
                <MenuItem Header="WYSIWYGのみ" Tag="Rich" Click="ViewMode_Click" />
                <Separator />
                <MenuItem Header="分割を50 : 50に戻す" Click="ResetSplit_Click" />
                <MenuItem Header="拡大" InputGestureText="Ctrl++" Click="ZoomIn_Click" />
                <MenuItem Header="縮小" InputGestureText="Ctrl+-" Click="ZoomOut_Click" />
                <MenuItem Header="実際のサイズ" InputGestureText="Ctrl+0" Click="ZoomReset_Click" />
            </MenuItem>
            <MenuItem Header="ヘルプ(_H)"><MenuItem Header="MDVieWについて" Click="About_Click" /></MenuItem>
        </Menu>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,9">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#68A18E" Margin="0,0,8,0"/><TextBlock x:Name="StateLabel" Text="準備完了" Foreground="{StaticResource Muted}" FontSize="11" /></StackPanel>
                <TextBlock x:Name="PositionLabel" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="11" Margin="18,0" />
                <TextBlock x:Name="EncodingLabel" Grid.Column="2" Text="UTF-8  ·  LF  ·  100%" Foreground="{StaticResource Muted}" FontSize="11" />
            </Grid>
        </Border>
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="2,0,2,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <DockPanel Margin="0,0,16,0">
                    <Button DockPanel.Dock="Right" Content="＋" Click="New_Click" ToolTip="新しいタブ (Ctrl+N)" Padding="9,5" />
                    <TabControl x:Name="DocumentTabs" Background="Transparent" BorderThickness="0" SelectionChanged="Tabs_SelectionChanged" VerticalAlignment="Center" AutomationProperties.Name="開いているファイル">
                        <TabControl.Template><ControlTemplate TargetType="TabControl"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><TabPanel IsItemsHost="True" /></ScrollViewer></ControlTemplate></TabControl.Template>
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="Background" Value="#ECEEF3"/>
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabSurface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="White"/><Setter Property="Foreground" Value="#4C4CC5"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#E9E7F8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="#5555D7"/><Setter TargetName="TabSurface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                            </Style>
                        </TabControl.Resources>
                    </TabControl>
                </DockPanel>
                <Border Grid.Column="1" Background="#EBEDF2" CornerRadius="7" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SplitModeButton" Content="左右に並べる" Tag="Split" Click="ViewMode_Click" Padding="12,4" Background="White" FontSize="11" />
                        <Button x:Name="SourceModeButton" Content="テキスト" Tag="Source" Click="ViewMode_Click" Padding="12,4" FontSize="11" />
                        <Button x:Name="RichModeButton" Content="WYSIWYG" Tag="Rich" Click="ViewMode_Click" Padding="12,4" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1,1,1,0" CornerRadius="9,9,0,0" Padding="12,9">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="BlockStyle" Width="102" Height="30" SelectedIndex="0" SelectionChanged="BlockStyle_Changed" ToolTip="段落のスタイル" Margin="0,0,10,0" AutomationProperties.Name="段落のスタイル">
                            <ComboBoxItem Content="標準テキスト" Tag="0"/><ComboBoxItem Content="見出し 1" Tag="1"/><ComboBoxItem Content="見出し 2" Tag="2"/><ComboBoxItem Content="見出し 3" Tag="3"/>
                        </ComboBox>
                        <Button Content="B" FontWeight="Bold" Tag="Bold" Click="Format_Click" Style="{StaticResource ToolButton}" ToolTip="太字 (Ctrl+B)" AutomationProperties.Name="太字" />
                        <Button Content="I" FontStyle="Italic" FontFamily="Georgia" FontSize="16" Tag="Italic" Click="Format_Click" Style="{StaticResource ToolButton}" ToolTip="斜体 (Ctrl+I)" AutomationProperties.Name="斜体" />
                        <Button Tag="Strike" Click="Format_Click" Style="{StaticResource ToolButton}" ToolTip="取り消し線" AutomationProperties.Name="取り消し線"><TextBlock Text="S" TextDecorations="Strikethrough" /></Button>
                        <Button Content="&lt;/&gt;" FontFamily="Consolas" Tag="InlineCode" Click="Format_Click" Style="{StaticResource ToolButton}" ToolTip="インラインコード" AutomationProperties.Name="インラインコード" />
                        <Border Width="1" Background="{StaticResource Line}" Margin="10,4" />
                        <Button Content="• ≡" Tag="Bullet" Click="Format_Click" Style="{StaticResource ToolButton}" ToolTip="箇条書き" AutomationProperties.Name="箇条書き" />
                        <Button Content="1. ≡" Tag="Numbered" Click="Format_Click" Style="{StaticResource ToolButton}" ToolTip="番号付きリスト" AutomationProperties.Name="番号付きリスト" />
                        <Button Content="☑" Tag="Task" Click="Format_Click" Style="{StaticResource ToolButton}" ToolTip="タスクリスト" AutomationProperties.Name="タスクリスト" />
                        <Button Content="❞" FontSize="21" Tag="Quote" Click="Format_Click" Style="{StaticResource ToolButton}" ToolTip="引用" AutomationProperties.Name="引用" />
                        <Border Width="1" Background="{StaticResource Line}" Margin="10,4" />
                        <Button Content="リンク" Tag="Link" Click="Format_Click" Style="{StaticResource ToolButton}" ToolTip="リンクを挿入" />
                        <Button Content="表" Tag="Table" Click="Format_Click" Style="{StaticResource ToolButton}" ToolTip="表を挿入" />
                        <Button Content="コード" Tag="CodeBlock" Click="Format_Click" Style="{StaticResource ToolButton}" ToolTip="コードブロック" />
                        <Button Content="―" Tag="Rule" Click="Format_Click" Style="{StaticResource ToolButton}" ToolTip="水平線" AutomationProperties.Name="水平線" />
                        <Border Width="1" Background="{StaticResource Line}" Margin="10,4" />
                        <Button Content="↶" Tag="Undo" Click="Format_Click" Style="{StaticResource ToolButton}" ToolTip="元に戻す (Ctrl+Z)" AutomationProperties.Name="元に戻す" />
                        <Button Content="↷" Tag="Redo" Click="Format_Click" Style="{StaticResource ToolButton}" ToolTip="やり直し (Ctrl+Y)" AutomationProperties.Name="やり直し" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border x:Name="FindBar" Grid.Row="2" Visibility="Collapsed" Background="#F0EFFB" Padding="14,8" BorderBrush="{StaticResource Line}" BorderThickness="1,0">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="FindBox" Width="240" Padding="6,4" KeyDown="FindBox_KeyDown" AutomationProperties.Name="検索するテキスト" />
                    <Button Content="次を検索" Click="FindNext_Click" /><TextBlock x:Name="FindResult" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="12,0" />
                    <Button Content="閉じる" Click="CloseFind_Click" />
                </StackPanel>
            </Border>
            <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="0,0,9,9">
                <Grid x:Name="EditorGrid" ClipToBounds="True">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SourceColumn" Width="1*" MinWidth="180"/><ColumnDefinition x:Name="DividerColumn" Width="9"/><ColumnDefinition x:Name="RichColumn" Width="1*" MinWidth="180"/></Grid.ColumnDefinitions>
                    <Grid x:Name="SourcePane" Background="#FBFBFD">
                        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border x:Name="SourcePaneHeader" Tag="Source" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,0" Background="Transparent" Cursor="SizeAll" ToolTip="この見出しを反対側の領域へドラッグして入れ替え" PreviewMouseLeftButtonDown="PaneHeader_MouseDown" PreviewMouseMove="PaneHeader_MouseMove" PreviewMouseLeftButtonUp="PaneHeader_MouseUp" LostMouseCapture="PaneHeader_LostCapture">
                            <Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="&lt;/&gt;" FontFamily="Consolas" Foreground="#777B93" Margin="0,0,9,0"/><TextBlock Text="MARKDOWN" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="#777B93" /></StackPanel><TextBlock Text="テキストを編集" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#959AA7" /></Grid>
                        </Border>
                        <ContentControl x:Name="SourceHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    </Grid>
                    <GridSplitter x:Name="PaneSplitter" Grid.Column="1" Width="9" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#F2F3F7"
                                  ShowsPreview="False" DragCompleted="Splitter_DragCompleted" MouseDoubleClick="Splitter_DoubleClick" Focusable="True" KeyboardNavigation.TabIndex="0"
                                  ToolTip="ドラッグして幅を変更 / ダブルクリックで均等に分割" AutomationProperties.Name="左右の編集領域の幅を変更">
                        <GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Border x:Name="GripBackground" Background="{TemplateBinding Background}"><Border Width="3" Height="34" Background="#C9CBD8" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="GripBackground" Property="Background" Value="#DFDDF7" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="GripBackground" Property="Background" Value="#DFDDF7" /></Trigger></ControlTemplate.Triggers></ControlTemplate></GridSplitter.Template>
                    </GridSplitter>
                    <Grid x:Name="RichPane" Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border x:Name="RichPaneHeader" Tag="Rich" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,0" Background="Transparent" Cursor="SizeAll" ToolTip="この見出しを反対側の領域へドラッグして入れ替え" PreviewMouseLeftButtonDown="PaneHeader_MouseDown" PreviewMouseMove="PaneHeader_MouseMove" PreviewMouseLeftButtonUp="PaneHeader_MouseUp" LostMouseCapture="PaneHeader_LostCapture">
                            <Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="✎" Foreground="#777B93" Margin="0,0,9,0"/><TextBlock Text="WYSIWYG" FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold" Foreground="#777B93" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse Width="5" Height="5" Fill="#6FAD96" Margin="0,0,6,0"/><TextBlock Text="直接編集できます" FontSize="10" Foreground="#959AA7" /></StackPanel></Grid>
                        </Border>
                        <ContentControl x:Name="RichHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
